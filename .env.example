# ScoreBoard Environment Configuration Template
# Copy this file to .env and fill in your actual Supabase credentials.
# NEVER commit your actual .env file to public Git repositories!

# Supabase Project URL (Publicly safe client URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Client-side / Public key for reads)
SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER ship to Android or browser JS!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Flask Secret Key
FLASK_SECRET_KEY=your-random-flask-secret-key

# --- Admin accounts ---
# Admin credentials are NEVER configured here. Multiple admin accounts are
# managed with the CLI (see manage_admins.py) and require Supabase to be
# configured: real Supabase Auth users are listed in the `admins` table.

# --- Server hardening ---
# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty to permit same-origin requests only (recommended — the web
# frontend is served by this same Flask app).
# CORS_ALLOWED_ORIGINS=https://leaderboard.example.com
CORS_ALLOWED_ORIGINS=

# Debug mode. NEVER enable in production (enables the Werkzeug RCE debugger).
# FLASK_DEBUG=1
FLASK_DEBUG=

# Bind address / port (defaults: 0.0.0.0 / 5000)
# HOST=0.0.0.0
# PORT=5000