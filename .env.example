# ScoreBoard Environment Configuration Template
# Copy this file to .env and fill in your actual Supabase credentials.
# NEVER commit your actual .env file to public Git repositories!

# Supabase Project URL (Publicly safe client URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Client-side / Public key for reads)
SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER ship to Android or browser JS!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Flask Secret Key
FLASK_SECRET_KEY=your-random-flask-secret-key
