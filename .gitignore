# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/

# Test, coverage & lint caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Dependencies
node_modules/
react-widgets/node_modules/

# React widget build output (regenerated by `npm run build` / Vercel build script)
app/static/js/widgets.bundle.js

# npm / yarn logs
npm-debug.log*
yarn-error.log*

# Android build artifacts & Gradle caches
.gradle/
android/.gradle/
android/build/
android/app/build/
android/captures/
*.apk
*.aar
*.log

# Keystores & Signing Secrets
*.jks
*.keystore
keystore.properties
release.keystore

# Environments
.env
.env.*
!.env.example
.venv
env/
venv/

# Vercel (local CLI link/cache; never commit secrets)
.vercel/

# Local data & assets not served by Flask (see .vercelignore)
assets/
data/
logo/

# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/